# MealMate environment variables.
#
# Local dev:    copy to `.env.local` and fill in real values
# Vercel:       set the same keys in Project Settings → Environment Variables
#
# NEVER commit `.env.local`. `.env*` is gitignored.
# NEVER set SUPABASE_SERVICE_ROLE_KEY in any client-bundled code — it
#   bypasses RLS and shipping it to the browser is a full database breach.

# ---------------------------------------------------------------
# Supabase — Postgres connection (used by Drizzle + db-ping script)
# ---------------------------------------------------------------
# Get from: Supabase Dashboard → Connect → "Session pooler" tab.
# Use the Session Pooler URL (port 5432, hostname *.pooler.supabase.com).
# The direct connection (db.PROJECT_REF.supabase.co) is IPv6-only on the
# free tier and won't work from most networks or Vercel.
DATABASE_URL="postgresql://postgres.PROJECT_REF:YOUR_DB_PASSWORD@aws-1-us-west-1.pooler.supabase.com:5432/postgres"

# ---------------------------------------------------------------
# Supabase — public client (browser-safe; ships in client bundle)
# ---------------------------------------------------------------
# Get from: Supabase Dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# ---------------------------------------------------------------
# Supabase — server-only secret (BYPASSES RLS)
# ---------------------------------------------------------------
# Get from: Supabase Dashboard → Project Settings → API → "Reveal" on
# the `service_role` row (or the new `sb_secret_...` key).
# Use only in: webhook handlers, cron jobs, server-side admin operations.
# Never import in a Client Component.
SUPABASE_SERVICE_ROLE_KEY=""

# ---------------------------------------------------------------
# Stripe — payments (test mode while building; live needs business verification)
# ---------------------------------------------------------------
# Get from: dashboard.stripe.com/test/apikeys (toggle Test mode ON)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_SECRET_KEY="sk_test_..."
# Created AFTER you register a webhook endpoint at:
#   Stripe Dashboard → Developers → Webhooks → Add endpoint
#   URL: https://<your-app>.vercel.app/api/webhooks/stripe
#   Events: payment_intent.succeeded, payment_intent.payment_failed
# Copy the signing secret on the endpoint detail page.
STRIPE_WEBHOOK_SECRET="whsec_..."

# ---------------------------------------------------------------
# Plaid — Phase 4b diner card linking + Phase 4c transaction matching
# ---------------------------------------------------------------
# https://dashboard.plaid.com → API → Keys
# Use the **Sandbox** secret here — never paste a Development or
# Production secret into a committed file or any .env*.
PLAID_CLIENT_ID=""
PLAID_SECRET=""
# Default is `sandbox`. Phase 4c will switch to `development` for the
# pilot (Plaid charges per item but it's still cheap; production needs
# Plaid's compliance review).
PLAID_ENV="sandbox"

# AES-256-GCM key used to encrypt Plaid access_tokens at rest in
# plaid_items.access_token. Must decode to exactly 32 bytes.
# Generate per environment with:
#   openssl rand -base64 32
# Rotating this key invalidates every existing linked Item (re-link
# required). Never commit a real value.
PLAID_TOKEN_ENCRYPTION_KEY=""
